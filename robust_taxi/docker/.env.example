# Runtime environment
APP_ENV=development
SECRET_KEY=replace-with-a-random-value
LOG_LEVEL=INFO

# MongoDB
MONGODB_URI=mongodb://mongodb:27017/
DATABASE_NAME=smart_taxi_ads

# Flask
FLASK_HOST=0.0.0.0
FLASK_PORT=8080
FLASK_DEBUG=False
API_BASE_URL=http://localhost:8080
CDN_BASE_URL=

# MQTT / EMQX
MQTT_BROKER_HOST=emqx
MQTT_BROKER_PORT=1883
MQTT_CLIENT_ID_PREFIX=robust-taxi
MQTT_USERNAME=
MQTT_PASSWORD=
EMQX_ALLOW_ANONYMOUS=true

# Video storage
UPLOAD_ROOT=/app/uploads
DEFAULT_VIDEO=default_ad_loop.mp4
# Azure VM only: directory on the mounted Managed Data Disk
VIDEO_DATA_PATH=/data/robust-taxi/uploads
